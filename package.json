{
  "name": "erzberg",
  "version": "1.22.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/licenses.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "npm run test:light && npm run test:heavy",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:ui": "playwright test --ui",
    "update-presets": "node scripts/update-presets.js",
    "font": "node scripts/build-font.js",
    "logo": "node scripts/build-logo.js",
    "thumbs": "node scripts/generate-thumbs.js",
    "fonts:single-line": "node scripts/build-single-line-fonts.js",
    "licenses": "node scripts/licenses.js",
    "test:light": "playwright test --project=light --workers=4",
    "test:heavy": "playwright test --project=heavy --workers=1",
    "test:all": "playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "geotiff": "^3.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.184.0",
    "three-mesh-bvh": "^0.9.15",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "opentype.js": "^2.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
