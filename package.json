{
  "name": "erzberg",
  "version": "1.73.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "erzberg": "scripts/erzberg.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/licenses.js",
    "preview": "vite preview",
    "cli": "node scripts/erzberg.js",
    "lint": "eslint .",
    "test": "npm run test:light && npm run test:heavy",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:ui": "playwright test --ui",
    "update-presets": "node scripts/update-presets.js",
    "heightmap": "node scripts/build-heightmap.js",
    "section-labels": "node scripts/build-section-labels.js",
    "font": "node scripts/build-font.js",
    "logo": "node scripts/build-logo.js",
    "thumbs": "node scripts/generate-thumbs.js",
    "fonts:single-line": "node scripts/build-single-line-fonts.js",
    "licenses": "node scripts/licenses.js",
    "test:light": "playwright test --project=light --workers=4",
    "test:heavy": "playwright test --project=heavy --workers=1",
    "test:all": "playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tmcw/togeojson": "^7.1.3",
    "but-unzip": "^0.1.10",
    "delaunator": "^5.1.0",
    "geotiff": "^3.0.5",
    "geotiff-geokeys-to-proj4": "^2026.10.9",
    "proj4": "^2.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shpjs": "^6.2.0",
    "three": "0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "opentype.js": "^2.0.0",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
